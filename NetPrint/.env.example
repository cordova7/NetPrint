# NetPrint runtime configuration
# -------------------------------
# Drop a copy of this file named ".env" in the same folder as NetPrint.exe
# and edit the values below. Lines starting with # are comments.
# Quoted values are supported: SCANNER_DIRECTORY="C:\Users\you\Scans"

# Folder NetPrint watches for incoming PDFs.
# Leave blank to use the value saved via Opciones, or the user's Desktop.
# Examples:
#   SCANNER_DIRECTORY=D:\scaner
#   SCANNER_DIRECTORY=C:\Users\Marcos\Documents\Imprimir
SCANNER_DIRECTORY=